{
  "appId": "com.pocketirishdance.app",
  "appName": "Pocket Irish Dance",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a4e50",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#0a4e50",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#0b7a75"
    }
  }
}
